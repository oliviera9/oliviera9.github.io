---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{% for route in site.data.routes %}{% assign paths = route[1] %}{% for language in paths %}
  <url>
    <loc>{{ language[1] | absolute_url }}</loc>
    <xhtml:link rel="alternate" hreflang="it" href="{{ paths.it | absolute_url }}"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ paths.en | absolute_url }}"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ paths.it | absolute_url }}"/>
  </url>
{% endfor %}{% endfor %}
</urlset>
